{
  // Emit config for the staged release tree (AHQ-196/AHQ-197). The root
  // tsconfig.json is typecheck-only (noEmit); this one compiles both build
  // surfaces — the CLI graph under src/ and the shipped math workflow — to
  // release/dist, mirroring the repo layout (rootDir "."), so the compiled
  // workflow JS lands INSIDE the staged package where Node package
  // self-reference resolves 'agentic-hq/tools/claude-code' against the
  // generated release manifest.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "release/dist",
    "types": ["node"],
    // typecheck-only mapping so the workflow's self-referencing import resolves
    // without a node_modules symlink; does not affect emitted specifiers
    "paths": {
      "agentic-hq/tools/claude-code": ["./src/tools/marshalled-io-tools/claude-code/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    ".agentic-hq/plugins/agentic-hq-demos-plugin/skills/math-workflow/ts-workflow/src/**/*"
  ]
}
