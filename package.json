{
  "name": "agentic-hq",
  "version": "0.1.0",
  "description": "Agentic HQ - Orchestrating agentic software development teams",
  "type": "module",
  "private": true,
  "scripts": {
    "// VALIDATION": "validate = typecheck + lint + unit tests (REQUIRED before commits)",
    "validate": "pnpm typecheck && pnpm lint:check && pnpm test",
    "typecheck": "tsc --noEmit",
    "// LINTING": "lint:check = read-only, lint:fix = auto-fix (use carefully)",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "// FORMATTING": "format:check = read-only, format:fix = auto-fix (use carefully)",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "// CLI COMMANDS": "hello-world = runs hello-world.ts and prints Hello world",
    "hello-world": "tsx src/misc/hello-world-cli.ts",
    "// UNIT TEST COMMANDS": "test = ALL unit tests, test:hello-world = ONLY hello-world unit test",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:hello-world": "vitest run --config vitest.unit.config.ts tests/unit/hello-world.unit.test.ts",
    "// SMOKE TEST COMMANDS": "test:smoke = ALL smoke tests, test:smoke:hello-world = ONLY hello-world smoke test",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:smoke:hello-world": "vitest run --config vitest.smoke.config.ts tests/smoke/hello-world.smoke.test.ts",
    "// WATCH MODE DISABLED": "Watch mode causes AI test execution to hang"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "claude": "^0.1.1",
    "cmd-ts": "^0.14.3",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-vitest": "^0.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.2"
  }
}
