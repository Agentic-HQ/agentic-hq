# Require pnpm to use the existing pnpm-lock.yaml exactly.
#
# This prevents plain `pnpm install` from silently resolving newer dependency
# versions when package.json and pnpm-lock.yaml disagree.
#
# If dependency changes are intentional, use an explicit command such as:
#   pnpm add <package> --no-frozen-lockfile
#   pnpm update --no-frozen-lockfile
#   pnpm install --no-frozen-lockfile
#
# Security purpose:
# Reduces supply-chain risk by making dependency version changes deliberate
# and visible in package.json / pnpm-lock.yaml diffs.
frozen-lockfile=true
